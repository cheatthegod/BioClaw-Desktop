# Dependencies
node_modules/
.pnp.*
.yarn/

# Build outputs
dist/
dist-electron/
build/
.next/
out/

# Tauri / Rust
src-tauri/target/
src-tauri/gen/schemas/
src-tauri/Cargo.lock.bak
release/
# Any nested cargo project (e.g. sidecar/launcher-win/target/)
**/target/
**/Cargo.lock.bak

# Vendored uv binaries (~60 MB each). Re-fetched per build via
# `npm run vendor:uv` — the version pin lives in scripts/vendor-uv.sh.
# (Sidecar / launcher binaries DO commit because they're tiny and we
# want CI builds to be reproducible without a full build pipeline.)
src-tauri/binaries/uv-*

# Vendored bioclaw-env zip (~250-400 MB per platform). Generated by
# `npm run vendor:env` from bioclaw-env/pyproject.toml + uv.lock. CI
# regenerates per matrix entry; the triple-less `bioclaw-env.zip`
# alias is what Tauri ships as a bundle resource.
src-tauri/binaries/bioclaw-env*.zip

# bioclaw-env build-time outputs — same story as `.venv/` (locally
# materialised, never committed).
bioclaw-env/_base/
bioclaw-env/_uv-cache/

# Vite / build cache
.vite/
.cache/
*.tsbuildinfo

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Env / secrets — NEVER commit
.env
.env.*
!.env.example

# Signing keys & artifacts (use GitHub Secrets in CI instead)
*.p12
*.pfx
*.cer
*.key
*.pem
keystore.*
notarytool-*.json
private-key.json

# Logs
*.log
logs/

# Test outputs
coverage/
.nyc_output/

# OS junk
.AppleDouble
.LSOverride
ehthumbs.db
.signing-keys/
