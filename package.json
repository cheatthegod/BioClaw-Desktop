{
  "name": "bioclaw",
  "version": "0.1.0",
  "description": "BioClaw Desktop — AI-powered bioinformatics assistant for your desktop.",
  "author": {
    "name": "Qingran Cai",
    "email": "cheatthegod@users.noreply.github.com"
  },
  "type": "module",
  "main": "electron-dist/electron/main.js",
  "scripts": {
    "build": "tsc",
    "build:agent-runner": "cd container/agent-runner && npm ci --ignore-scripts && npm run build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "web": "node scripts/start-web.mjs",
    "open:web": "node scripts/open-local-web.mjs",
    "stop:web": "node scripts/stop-bioclaw-web.mjs",
    "check:openrouter": "node scripts/check-openrouter.mjs",
    "agents": "tsx src/agent-admin.ts",
    "cli": "tsx src/cli.ts",
    "auth": "tsx src/channels/whatsapp/auth.ts",
    "typecheck": "tsc --noEmit",
    "rebuild:node": "npm rebuild better-sqlite3",
    "pretest": "npm run rebuild:node",
    "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json",
    "electron:dev": "npm run build:agent-runner && npm run build:electron && electron .",
    "electron:build": "npm run build:agent-runner && npm run build:electron && electron-builder",
    "electron:build:win": "npm run build:agent-runner && npm run build:electron && electron-builder --win",
    "electron:build:mac": "npm run build:agent-runner && npm run build:electron && electron-builder --mac",
    "electron:build:linux": "npm run build:agent-runner && npm run build:electron && electron-builder --linux",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@slack/bolt": "^4.6.0",
    "@wecom/aibot-node-sdk": "^1.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "better-sqlite3": "^12.9.0",
    "cron-parser": "^5.5.0",
    "discord.js": "^14.25.1",
    "dompurify": "^3.3.3",
    "dotenv": "^17.3.1",
    "marked": "^17.0.4",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode-terminal": "^0.12.0",
    "weixin-agent-sdk": "^0.1.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.19.17",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitest/coverage-v8": "^4.0.18",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
