{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BioClaw",
  "version": "0.4.1",
  "identifier": "tech.bioclaw.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BioClaw",
        "url": "https://beta.bioclaw.tech/",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "shadow": true,
        "acceptFirstMouse": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: ipc: http://ipc.localhost; connect-src 'self' tauri: ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* https://chat.bioclaw.tech wss://chat.bioclaw.tech https://beta.bioclaw.tech wss://beta.bioclaw.tech; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'unsafe-eval'; frame-src https://chat.bioclaw.tech https://beta.bioclaw.tech https://*.bioclaw.tech",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    },
    "trayIcon": {
      "id": "bioclaw-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "copyright": "Copyright (c) 2026 BioClaw",
    "shortDescription": "AI-powered biomedical research agent",
    "longDescription": "BioClaw Desktop brings the BioClaw biomedical research agent (chat.bioclaw.tech) into a native macOS / Windows / Linux app with system tray, native notifications, and an optional local agent runner.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "exceptionDomain": "bioclaw.tech",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "SimpChinese"
        ]
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "bioclaw"
        ]
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://chat.bioclaw.tech/desktop/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBMTY1RkIxNTI5MjE2NUUKUldSZUZwSlNzVjhXMnVrZ2hHZ29XcWJRTFQ5T3RNeDEyejRsM3gydmkyemRvam56UllXd2RIbm0K"
    }
  }
}
